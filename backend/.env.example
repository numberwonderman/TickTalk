# mock | qwen_local_8b
# mock is the default and needs no GPU. qwen_local_8b loads Qwen3-VL-8B
# in-process, so only set it on a machine with a GPU (the RunPod spot pod
# used for the eval pass -- see docs/BUILD_PLAN.md Milestone 4).
VISION_MODEL_BACKEND=mock

# qwen_local_8b runs in-process (loaded in memory by the backend), not over
# HTTP -- no endpoint/port to configure here. See
# backend/app/vision/models/qwen3_vl_8b_adapter.py for what's still needed
# to finish wiring it up.

# Leave unset to skip S3 storage entirely (backend works fine without it)
TICKTALK_S3_BUCKET=
AWS_REGION=us-east-1

CORS_ALLOW_ORIGINS=http://localhost:5173
