# mock | qwen_local
VISION_MODEL_BACKEND=mock

# qwen_local runs Qwen in-process (loaded in memory by the backend), not
# over HTTP -- no endpoint/port to configure here. See
# backend/app/vision/models/qwen_vision_adapter.py for what's still needed
# from Brett to finish wiring this up.

# Leave unset to skip S3 storage entirely (backend works fine without it)
TICKTALK_S3_BUCKET=
AWS_REGION=us-east-1

CORS_ALLOW_ORIGINS=http://localhost:5173
