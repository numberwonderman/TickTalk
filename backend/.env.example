# mock | qwen_local_32b | qwen_local_8b
# Two Qwen backends on purpose, no default preferred -- see
# backend/app/vision/models/qwen3_vl_8b_adapter.py for why we're
# evaluating both rather than assuming the 32B is better.
VISION_MODEL_BACKEND=mock

# Both qwen_local_* backends run in-process (loaded in memory by the
# backend), not over HTTP -- no endpoint/port to configure here. See
# backend/app/vision/models/qwen2_5_vl_32b_adapter.py and
# qwen3_vl_8b_adapter.py for what's still needed from Brett to finish
# wiring either one up.

# Leave unset to skip S3 storage entirely (backend works fine without it)
TICKTALK_S3_BUCKET=
AWS_REGION=us-east-1

CORS_ALLOW_ORIGINS=http://localhost:5173
